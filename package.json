{
  "name": "careeros-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CareerOS — AI-powered Placement Readiness & Career Operating System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/backend run dev",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "start": "npm --workspace=apps/backend start",
    "build": "npm --workspace=apps/frontend run build",
    "test": "npm --workspace=apps/backend test",
    "test:watch": "npm --workspace=apps/backend run test:watch",
    "test:smoke": "npm --workspace=apps/backend run test:smoke",
    "seed": "npm --workspace=apps/backend run seed"
  },
  "keywords": [
    "careeros",
    "placement",
    "edtech",
    "ai",
    "gemini",
    "ats",
    "react",
    "express",
    "mongodb"
  ],
  "author": "CareerOS Team",
  "license": "ISC"
}
